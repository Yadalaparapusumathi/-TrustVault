# Copy to .env and fill in. Generate secrets with:  openssl rand -base64 32
# Never commit .env.

# Public hostname (production compose / Caddy only). Caddy obtains a TLS certificate for it automatically.
TV_DOMAIN=trustvault.example.com

# PostgreSQL superuser (used only by the postgres container to initialise roles)
POSTGRES_PASSWORD=change-me-superuser

# Schema owner (Flyway migrations) and the restricted application role
TV_DB_OWNER_PASSWORD=change-me-owner
TV_DB_APP_PASSWORD=change-me-app

# 32 random bytes, base64. Wraps every file's data key. Losing it makes stored files unreadable.
TV_MASTER_KEY=
# >= 32 random bytes, base64. Keys the audit HMAC chain. Keep it outside the database and its backups.
TV_AUDIT_HMAC_KEY=

# Demo seed data: created once, on an empty database. Set to false for a real deployment.
TV_SEED_ENABLED=true
TV_SEED_PASSWORD_ADMIN=
TV_SEED_PASSWORD_OWNER=
TV_SEED_PASSWORD_VIEWER=

# Set to false ONLY for local http://localhost testing without TLS.
TV_COOKIE_SECURE=true
